# 复制为 .env 后按需填写；不要提交真实密钥。
#
# LLM_PROVIDER: auto | llm | mock
#   auto = 有 OPENAI_API_KEY 时用真实模型，否则自动回退到离线确定性 Mock（默认）
#   llm  = 强制真实模型（缺少 key 会直接报配置错误，不会静默回退）
#   mock = 强制离线 Mock（仅验证流程与安全边界，不代表真实模型决策效果）
LLM_PROVIDER=auto

# OpenAI 兼容接口（DeepSeek / Qwen / Moonshot / OpenAI 等均可）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat
OPENAI_TEMPERATURE=0.0

# ReAct 执行预算（达到上限时返回明确的 incomplete 状态）
AGENT_MAX_STEPS=14
AGENT_MAX_TOOL_CALLS=16
AGENT_TIMEOUT_SEC=60

# 草稿状态目录（JSON 文件，仅本地）
AGENT_STATE_DIR=.runtime
